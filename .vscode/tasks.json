{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "nimdbgPath",
      "type": "command",
      "command": "nim-debugger.getNimdbgPath"
    }
  ],
  "tasks": [
    {
      "label": "nim: compile current file (debug)",
      "type": "shell",
      "command": "nim",
      "args": [
        "c",
        "--debugger:native",
        "--path:${input:nimdbgPath}",
        "--import:nimdbg",
        "${file}"
      ],
      "problemMatcher": "$nim",
      "group": "build"
    },
    {
      "label": "nim: compile tests/test.nim (debug)",
      "type": "shell",
      "command": "nim",
      "args": [
        "c",
        "--debugger:native",
        "--path:${input:nimdbgPath}",
        "--import:nimdbg",
        "tests/test.nim"
      ],
      "problemMatcher": "$nim",
      "group": "test"
    },
    {
      "label": "nim: compile examples/sipmuc.nim (debug)",
      "type": "shell",
      "command": "nim",
      "args": [
        "c",
        "--debugger:native",
        "--path:${input:nimdbgPath}",
        "--import:nimdbg",
        "examples/sipmuc.nim"
      ],
      "problemMatcher": "$nim",
      "group": "test"
    }
  ]
}