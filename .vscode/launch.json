{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "nimdbg",
      "request": "launch",
      "name": "Debug: current file",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "nim: compile current file (debug)",
      "stopOnEntry": false
    },
    {
      "type": "nimdbg",
      "request": "launch",
      "name": "Debug: test: test",
      "program": "${workspaceFolder}/tests/test",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "nim: compile tests/test.nim (debug)",
      "stopOnEntry": false
    },
    {
      "type": "nimdbg",
      "request": "launch",
      "name": "Debug: test: sipmuc",
      "program": "${workspaceFolder}/examples/sipmuc",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "nim: compile examples/sipmuc.nim (debug)",
      "stopOnEntry": false
    }
  ]
}